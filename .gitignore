nbproject/

# Build artifacts
/build/
/dist/ # Already present, but good to ensure
/web-build/ # Already present
/coverage/
.nyc_output/

# Environment variables
.env
.env.*
!.env.example
# (It's good practice to commit a .env.example with placeholder values)

# TypeScript
*.tsbuildinfo
tsconfig.tsbuildinfo

# Yarn PnP (if used)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# EAS Build specific (if using EAS)
eas-build-pre-upload.tar.gz
*.apk
*.aab
*.ipa
*.tar.gz # General tarballs if they are build outputs

# Firebase (if used)
google-services.json # Typically downloaded, not versioned if project specific
GoogleService-Info.plist # Same as above

# Temporary files
*.tmp
*~
~$*

# Windows specific
Desktop.ini
ehthumbs.db
ehthumbs_vista.db

# Other
*.orig
*.bak
*.seed
local.properties # Android specific local properties
