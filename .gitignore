*.provisionprofile

# Metro Bundler
.metro-health-check*
.metro/

# Debugging
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
logs/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# IDE files
.idea/
.vscode/
*.project
*.classpath
*.cpc
*.launch
*.suo
